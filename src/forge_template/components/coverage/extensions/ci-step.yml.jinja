
- name: Coverage
  run: uv run poe coverage -- --cov-report=xml

- name: Upload coverage
  if: {% raw %}${{ matrix.python-version == '{% endraw %}{{ python.development }}{% raw %}' }}{% endraw %}
  uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
  with:
    name: coverage-xml
    path: coverage.xml
    if-no-files-found: error
