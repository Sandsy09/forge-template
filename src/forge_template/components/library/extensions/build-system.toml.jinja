{% if options.library.packaging_mode == "uv-build-static" -%}
requires = ["uv_build>=0.12,<0.13"]
build-backend = "uv_build"
{%- elif options.library.packaging_mode == "hatchling-vcs" -%}
requires = ["hatchling", "hatch-vcs"]
build-backend = "hatchling.build"
{%- else -%}
requires = ["hatchling"]
build-backend = "hatchling.build"
{%- endif %}
