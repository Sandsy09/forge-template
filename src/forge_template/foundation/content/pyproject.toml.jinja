{#- Foundation owns neutral project identity, licence, and the mandatory
   declared/locked development environment (foundation-guarantees.md). Each
   selected archetype's own packaging shape, metadata, runtime dependencies,
   classifiers, and entry points attach through the named, archetype-neutral
   extension points below; see docs/library-archetype.md and
   docs/cli-application-archetype.md. #}
{%- set spdx_license = {
    "mit": "MIT",
    "apache-2.0": "Apache-2.0",
    "proprietary": "LicenseRef-Proprietary",
}.get(project.licence, project.licence) -%}
[project]
name = "{{ project.repository_name }}"
[[forge:extension pyproject-archetype-metadata]]
description = "{{ project.description }}"
readme = "README.md"
requires-python = "{{ python.requires_python }}"
license = "{{ spdx_license }}"
{%- if project.authors %}
authors = [
{%- for author in project.authors %}
    { name = "{{ author.name }}"{% if author.email %}, email = "{{ author.email }}"{% endif %} },
{%- endfor %}
]
{%- endif %}
classifiers = [
    [[forge:extension pyproject-classifiers]]
]
dependencies = [
    [[forge:extension pyproject-runtime-dependencies]]
]
[[forge:extension pyproject-entry-points]]

[build-system]
[[forge:extension pyproject-build-system]]

[[forge:extension pyproject-build-configuration]]

# -----------------------------------------------------------------------------
# Dependency groups (PEP 735) -- not shipped to consumers
# -----------------------------------------------------------------------------

[dependency-groups]
lint = [
    "ruff>=0.14",
]
test = [
    "pytest>=8.3",
]
typecheck = [
    "mypy>=1.14",
]
dev = [
    { include-group = "lint" },
    { include-group = "test" },
    { include-group = "typecheck" },
    "poethepoet>=0.31",
]

[tool.uv]
default-groups = ["dev"]

# -----------------------------------------------------------------------------
# Ruff
# -----------------------------------------------------------------------------

[tool.ruff]
line-length = 88
target-version = "py{{ python.minimum | replace('.', '') }}"

[tool.ruff.lint]
select = [
    "E", "W",    # pycodestyle
    "F",         # pyflakes
    "I",         # isort
    "N",         # pep8-naming
    "UP",        # pyupgrade
    "B",         # flake8-bugbear
    "A",         # flake8-builtins
    "C4",        # flake8-comprehensions
    "SIM",       # flake8-simplify
    "PTH",       # flake8-use-pathlib
    "RUF",       # ruff-specific
    "ANN",       # flake8-annotations
    "D",         # pydocstyle
]
ignore = [
    "D107",      # __init__ docstring - covered by the class docstring
    "ANN401",    # allow Any where deliberately used
]

[tool.ruff.lint.per-file-ignores]
"tests/**/*.py" = ["D", "ANN", "S101"]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.format]
docstring-code-format = true

# -----------------------------------------------------------------------------
# Type checking
# -----------------------------------------------------------------------------

[tool.mypy]
python_version = "{{ python.minimum }}"
strict = true
warn_unreachable = true
warn_unused_ignores = true

# -----------------------------------------------------------------------------
# Tests
# -----------------------------------------------------------------------------

[tool.pytest.ini_options]
minversion = "8.0"
addopts = [
    "-ra",
    "--strict-markers",
    "--strict-config",
    "--import-mode=importlib",
]

# -----------------------------------------------------------------------------
# Tasks -- the single definition. Run via `uv run poe <task>`.
# -----------------------------------------------------------------------------

[tool.poe.tasks]
"lock:check" = "uv lock --check"
lint = "ruff check ."
format = "ruff format ."
"lint:fix" = "ruff check --fix ."
"format:check" = "ruff format --check ."
typecheck = "mypy ."
test = "pytest"
check = ["lock:check", "format:check", "lint", "typecheck", "test"]
