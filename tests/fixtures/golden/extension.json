{
  "order": [
    "library",
    "coverage",
    "github"
  ],
  "targets": {
    ".coveragerc": {
      "extensions": [],
      "owner": {
        "id": "coverage",
        "kind": "component"
      },
      "target": ".coveragerc"
    },
    "ci.yml": {
      "extensions": [
        {
          "component_id": "coverage",
          "extension_point": "ci-steps"
        }
      ],
      "owner": {
        "id": "github",
        "kind": "component"
      },
      "target": "ci.yml"
    },
    "pyproject.toml": {
      "extensions": [],
      "owner": {
        "id": "library",
        "kind": "component"
      },
      "target": "pyproject.toml"
    }
  },
  "tree": {
    ".coveragerc": "[run]\nbranch = true\n",
    "ci.yml": "name: CI\njobs:\n  checks:\n    steps:\n      - name: Coverage\n        run: echo coverage\n",
    "pyproject.toml": "[project]\nname = \"example-project\"\nversion = \"0.1.0\"\nrequires-python = \">=3.11\"\n\n[build-system]\nbuild-backend = \"hatchling\"\n"
  }
}
