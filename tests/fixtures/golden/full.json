{
  "order": [
    "library",
    "changelog",
    "coverage",
    "documentation",
    "github"
  ],
  "targets": {
    ".coveragerc": {
      "extensions": [],
      "owner": {
        "id": "coverage",
        "kind": "component"
      },
      "regeneration": "replace",
      "target": ".coveragerc"
    },
    "a-top.txt": {
      "extensions": [],
      "owner": {
        "id": "changelog",
        "kind": "component"
      },
      "regeneration": "replace",
      "target": "a-top.txt"
    },
    "ci.yml": {
      "extensions": [
        {
          "component_id": "coverage",
          "extension_point": "ci-steps"
        }
      ],
      "owner": {
        "id": "github",
        "kind": "component"
      },
      "regeneration": "replace",
      "target": "ci.yml"
    },
    "mkdocs.yml": {
      "extensions": [],
      "owner": {
        "id": "documentation",
        "kind": "component"
      },
      "regeneration": "replace",
      "target": "mkdocs.yml"
    },
    "nested/a-deep.txt": {
      "extensions": [],
      "owner": {
        "id": "changelog",
        "kind": "component"
      },
      "regeneration": "replace",
      "target": "nested/a-deep.txt"
    },
    "pyproject.toml": {
      "extensions": [],
      "owner": {
        "id": "library",
        "kind": "component"
      },
      "regeneration": "replace",
      "target": "pyproject.toml"
    },
    "z-top.txt": {
      "extensions": [],
      "owner": {
        "id": "changelog",
        "kind": "component"
      },
      "regeneration": "replace",
      "target": "z-top.txt"
    }
  },
  "tree": {
    ".coveragerc": "[run]\nbranch = true\n",
    "a-top.txt": "top-level a\n",
    "ci.yml": "name: CI\njobs:\n  checks:\n    steps:\n      - name: Coverage\n        run: echo coverage\n",
    "mkdocs.yml": "site_name: \"Example Project\"\n",
    "nested/a-deep.txt": "nested a\n",
    "pyproject.toml": "[project]\nname = \"example-project\"\nversion = \"0.2.0\"\nrequires-python = \">=3.11\"\n\n[build-system]\nbuild-backend = \"uv_build\"\n",
    "z-top.txt": "top-level z\n"
  }
}
